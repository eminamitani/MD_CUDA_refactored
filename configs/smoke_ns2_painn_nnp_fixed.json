{
  "meta": {
    "name": "smoke_ns2_painn_nnp_fixed",
    "unit": "metal",
    "seed": 12345
  },
  "common_settings": {
    "atoms": {
      "mode": "from_file",
      "format": "xyz",
      "path": "./data/ns2_quenched.xyz"
    },
    "cell": {
      "type": "cubic"
    },
    "interactions": {
      "cell_list": false,
      "neighbour_list": {
        "cutoff": 5.0,
        "margin": 1.0,
        "max_neighbours": 1000
      },
      "potentials": {
        "type": "NNP_fixed",
        "cutoff": 5.0,
        "max_edges": 1000000,
        "model_path": "./models/deployed_painn_model_ns2.pt"
      }
    }
  },
  "steps": [
    {
      "name": "fixed-shape PaiNN smoke",
      "simulation": {
        "dt": 0.5,
        "simulation_time": 5.0,
        "ensemble": {
          "type": "NVE",
          "temperature": 300.0,
          "initialize_velocities": true
        },
        "use_graph": false
      },
      "observer": {
        "type": "linear",
        "interval": 10
      }
    }
  ]
}
